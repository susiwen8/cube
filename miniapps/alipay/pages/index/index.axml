<view class="page-shell">
  <view class="panel header-panel">
    <view class="tabs">
      <block a:for="{{tabs}}" a:for-item="item" a:for-index="index" a:key="id">
        <view
          class="tab {{mode === item.id ? 'tab-active' : ''}}"
          data-mode="{{item.id}}"
          onTap="handleModeChange"
        >
          {{item.label}}
        </view>
      </block>
    </view>
    <view class="size-strip">
      <text class="size-caption">Size</text>
      <view class="size-options">
        <block a:for="{{sizeOptions}}" a:for-item="item" a:for-index="index" a:key="value">
          <view
            class="size-chip {{cubeSize === item.value ? 'size-chip-active' : ''}}"
            data-size="{{item.value}}"
            onTap="handleSizeChange"
          >
            {{item.label}}
          </view>
        </block>
      </view>
      <text class="size-summary">{{sizeLabel}}</text>
    </view>
    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-label">Timer</text>
        <text class="stat-value">{{timerLabel}}</text>
      </view>
      <view class="stat-card">
        <text class="stat-label">Moves</text>
        <text class="stat-value">{{moveCount}}</text>
      </view>
      <view class="stat-card stat-wide">
        <text class="stat-label">Status</text>
        <text class="stat-value">{{statusLabel}}</text>
      </view>
    </view>
    <view a:if="{{cubeSize > 3}}" class="hint-text">Higher-order cubes use history fallback. Inner-slice notation uses 2R / 3U / 4F.</view>
  </view>

  <view
    id="canvasWrap"
    class="panel canvas-panel"
  >
    <view
      id="cubeTouchSurface"
      class="cube-touch-surface"
      onTouchStart="handleTouchStart"
      onTouchMove="handleTouchMove"
      onTouchEnd="handleTouchEnd"
    >
      <canvas
        id="cubeCanvas"
        canvas-id="cubeCanvas"
        style="width: 320px; height: 320px;"
      />
    </view>
    <view class="gesture-tip">Drag a sticker to turn a layer. Drag empty space to rotate the view.</view>
  </view>

  <view class="panel action-panel">
    <view class="action-row">
      <button size="mini" onTap="handleShuffle">Shuffle</button>
      <button size="mini" onTap="handleTimedShuffle">Shuffle + Start</button>
      <button size="mini" onTap="handleReset">Reset</button>
      <button size="mini" type="primary" onTap="handleAutoSolve">Auto Solve</button>
    </view>
    <view class="action-row">
      <button size="mini" onTap="handleStepSolve">Next Step</button>
      <button size="mini" onTap="handleTogglePlayback">{{playbackLabel}}</button>
      <button size="mini" onTap="handleLessonDemo">Demo Lesson</button>
    </view>
    <view class="queue-text">Current size: {{sizeLabel}}</view>
    <view class="queue-text">Solve queue: {{solveQueueLabel || 'None'}}</view>
    <view class="queue-text">Solve strategy: {{solveStrategyLabel}}</view>
  </view>

  <view class="panel lesson-panel">
    <view class="section-title">Tutorial</view>
    <view class="lesson-nav">
      <button size="mini" onTap="handlePrevLesson">Previous</button>
      <text class="lesson-count">{{currentLessonNumber}} / {{lessonCount}}</text>
      <button size="mini" onTap="handleNextLesson">Next</button>
    </view>
    <view class="lesson-title">{{lessonTitle}}</view>
    <view class="lesson-summary">{{lessonSummary}}</view>
    <view class="lesson-meta">Focus: {{lessonFocus}}</view>
    <view class="lesson-meta">Algorithm: {{lessonNotation}}</view>
    <view a:if="{{cubeSize > 3}}" class="lesson-meta">For higher-order cubes, use outer-layer algorithms as usual. Inner turns are written as 2R / 2U / 3F.</view>
  </view>

  <view class="panel records-panel">
    <view class="section-title">{{recordsTitle}}</view>
    <block a:if="{{records.length}}">
      <block a:for="{{records}}" a:for-item="item" a:for-index="index" a:key="index">
        <view class="record-item">{{item.label}}</view>
      </block>
    </block>
    <view a:else class="empty-records">No records yet</view>
  </view>
</view>
