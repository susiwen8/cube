<view class="page-shell">
  <view class="panel header-panel">
    <view class="tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="id"
        class="tab {{mode === item.id ? 'tab-active' : ''}}"
        data-mode="{{item.id}}"
        bindtap="handleModeChange"
      >
        {{item.label}}
      </view>
    </view>
    <view class="size-strip">
      <text class="size-caption">Size</text>
      <view class="size-options">
        <view
          wx:for="{{sizeOptions}}"
          wx:key="value"
          class="size-chip {{cubeSize === item.value ? 'size-chip-active' : ''}}"
          data-size="{{item.value}}"
          bindtap="handleSizeChange"
        >
          {{item.label}}
        </view>
      </view>
      <text class="size-summary">{{sizeLabel}}</text>
    </view>
    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-label">Timer</text>
        <text class="stat-value">{{timerLabel}}</text>
      </view>
      <view class="stat-card">
        <text class="stat-label">Moves</text>
        <text class="stat-value">{{moveCount}}</text>
      </view>
      <view class="stat-card stat-wide">
        <text class="stat-label">Status</text>
        <text class="stat-value">{{statusLabel}}</text>
      </view>
    </view>
    <view wx:if="{{cubeSize > 3}}" class="hint-text">Higher-order cubes use history fallback. Inner-slice notation uses 2R / 3U / 4F.</view>
  </view>

  <view
    id="canvasWrap"
    class="panel canvas-panel"
  >
    <view
      id="cubeTouchSurface"
      class="cube-touch-surface"
      catchtouchstart="handleTouchStart"
      catchtouchmove="handleTouchMove"
      catchtouchend="handleTouchEnd"
    >
      <canvas
        id="cubeCanvas"
        canvas-id="cubeCanvas"
        style="width: 320px; height: 320px;"
      />
    </view>
    <view class="gesture-tip">Drag a sticker to turn a layer. Drag empty space to rotate the view.</view>
  </view>

  <view class="panel action-panel">
    <view class="action-row">
      <button size="mini" bindtap="handleShuffle">Shuffle</button>
      <button size="mini" bindtap="handleTimedShuffle">Shuffle + Start</button>
      <button size="mini" bindtap="handleReset">Reset</button>
      <button size="mini" type="primary" bindtap="handleAutoSolve">Auto Solve</button>
    </view>
    <view class="action-row">
      <button size="mini" bindtap="handleStepSolve">Next Step</button>
      <button size="mini" bindtap="handleTogglePlayback">{{playbackLabel}}</button>
      <button size="mini" bindtap="handleLessonDemo">Demo Lesson</button>
    </view>
    <view class="queue-text">Current size: {{sizeLabel}}</view>
    <view class="queue-text">Solve queue: {{solveQueueLabel || 'None'}}</view>
    <view class="queue-text">Solve strategy: {{solveStrategyLabel}}</view>
  </view>

  <view class="panel lesson-panel">
    <view class="section-title">Tutorial</view>
    <view class="lesson-nav">
      <button size="mini" bindtap="handlePrevLesson">Previous</button>
      <text class="lesson-count">{{currentLessonNumber}} / {{lessonCount}}</text>
      <button size="mini" bindtap="handleNextLesson">Next</button>
    </view>
    <view class="lesson-title">{{lessonTitle}}</view>
    <view class="lesson-summary">{{lessonSummary}}</view>
    <view class="lesson-meta">Focus: {{lessonFocus}}</view>
    <view class="lesson-meta">Algorithm: {{lessonNotation}}</view>
    <view wx:if="{{cubeSize > 3}}" class="lesson-meta">For higher-order cubes, use outer-layer algorithms as usual. Inner turns are written as 2R / 2U / 3F.</view>
  </view>

  <view class="panel records-panel">
    <view class="section-title">{{recordsTitle}}</view>
    <block wx:if="{{records.length}}">
      <view wx:for="{{records}}" wx:key="index" class="record-item">
        <text>{{item.label}}</text>
      </view>
    </block>
    <view wx:else class="empty-records">No records yet</view>
  </view>
</view>
